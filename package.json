{
  "name": "toma",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "De una idea a un video animado: guion con IA, escenas animadas y material de Flow/ChatGPT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:desktop": "vite build && esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:playwright-core --external:electron-updater --outfile=dist-electron/main.cjs",
    "desktop": "npm run build:desktop && electron .",
    "dist": "npm run build:desktop && electron-builder --win",
    "dist:mac": "npm run build:desktop && electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "playwright-core": "^1.65.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  },
  "main": "dist-electron/main.cjs",
  "author": "Toma",
  "build": {
    "appId": "app.toma.desktop",
    "productName": "Toma",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Toma usa el micrófono para grabar tu voz en off."
      }
    },
    "publish": {
      "provider": "github",
      "owner": "AndresZea2003",
      "repo": "toma"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndresZea2003/toma.git"
  }
}
